generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// ==================== USERS ====================
model User {
  userId       String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  orders       Order[]


  @@map("users")
}


// ==================== ORDERS ====================
enum OrderKind {
  buy
  sell
}

enum OrderType {
  limit
  market
}

enum OrderStatus {
  pending
  partial
  filled
  cancelled
}


enum Market {
  TATA_INR
  PAYTM_INR
  ZOMATO_INR
}



model Order {
  orderId        String      @id @default(uuid())
  userId         String
  kind           OrderKind
  type           OrderType
  price          Float
  quantity       Float
  filledQuantity Float       @default(0)
  market         Market
  status         OrderStatus @default(pending)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user           User        @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@index([market, status])
  @@map("orders")
}